# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db
*.db-wal
*.db-shm

# private context (credentials, VPS info)
CONTEXTO-PRIVADO.md

# bundle cifrado de secretos generado por migrar.sh (NUNCA committear)
mercadito-secretos-*.tar.gz.gpg

# Firebase / FCM credentials — nunca committear
clave.json
google-services.json
*-firebase-adminsdk-*.json
*-service-account*.json

# APK binario (se sube al VPS vía rsync, no va a git)
/public/mercadito.apk

# Builds locales (AAB / APK descargados de EAS)
/builds/

# Catálogos de tiendas en bulk (datos comerciales)
/fatmacia_inmaculada_concepcion.txt
/farmacia_inmaculada_concepcion.txt
.claude/
